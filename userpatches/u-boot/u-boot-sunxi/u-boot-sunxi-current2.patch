From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: John Doe <john.doe@somewhere.on.planet>
Date: Wed, 27 May 2026 02:49:28 +0000
Subject: Patching u-boot sunxi files arch/arm/dts/sun7i-a20-hummingbird.dts

Signed-off-by: John Doe <john.doe@somewhere.on.planet>
---
 arch/arm/dts/sun7i-a20-hummingbird.dts | 55 +++++++---
 1 file changed, 40 insertions(+), 15 deletions(-)

diff --git a/arch/arm/dts/sun7i-a20-hummingbird.dts b/arch/arm/dts/sun7i-a20-hummingbird.dts
index 3def2a33059..2416dc5ab52 100644
--- a/arch/arm/dts/sun7i-a20-hummingbird.dts
+++ b/arch/arm/dts/sun7i-a20-hummingbird.dts
@@ -63,26 +63,25 @@
 
 	chosen {
 		stdout-path = "serial0:115200n8";
 	};
 
-	reg_mmc3_vdd: mmc3_vdd {
-		compatible = "regulator-fixed";
-		regulator-name = "mmc3_vdd";
-		regulator-min-microvolt = <3000000>;
-		regulator-max-microvolt = <3000000>;
-		enable-active-high;
-		gpio = <&pio 7 9 GPIO_ACTIVE_HIGH>; /* PH9 */
+	mmc3_pwrseq: pwrseq {
+		compatible = "mmc-pwrseq-simple";
+		reset-gpios = <&pio 7 9 GPIO_ACTIVE_LOW>; /* PH9 WL_REG_ON */
+		clocks = <&ccu CLK_OUT_A>;
+		clock-names = "ext_clock";
 	};
 
-	reg_gmac_vdd: gmac_vdd {
+	reg_gmac_vdd: gmac-3v3 {
 		compatible = "regulator-fixed";
-		regulator-name = "gmac_vdd";
-		regulator-min-microvolt = <3000000>;
-		regulator-max-microvolt = <3000000>;
+		regulator-name = "gmac-3v3";
+		regulator-min-microvolt = <3300000>;
+		regulator-max-microvolt = <3300000>;
+		startup-delay-us = <500000>;
 		enable-active-high;
-		gpio = <&pio 7 16 GPIO_ACTIVE_HIGH>; /* PH16 */
+		gpio = <&pio 7 16 GPIO_ACTIVE_HIGH>; /* PH16 GMAC_PWR */
 	};
 };
 
 &ahci {
 	target-supply = <&reg_ahci_5v>;
@@ -99,11 +98,11 @@
 
 &gmac {
 	pinctrl-names = "default";
 	pinctrl-0 = <&gmac_rgmii_pins>;
 	phy-handle = <&phy1>;
-	phy-mode = "rgmii";
+	phy-mode = "rgmii-id";
 	phy-supply = <&reg_gmac_vdd>;
 	status = "okay";
 };
 
 &i2c0 {
@@ -146,31 +145,46 @@
 		reset-deassert-us = <1000000>;
 	};
 };
 
 &mmc0 {
-	vmmc-supply = <&reg_vcc3v0>;
+	vmmc-supply = <&reg_vcc3v3>;
 	bus-width = <4>;
 	cd-gpios = <&pio 7 1 GPIO_ACTIVE_LOW>; /* PH1 */
 	status = "okay";
 };
 
 &mmc3 {
-	vmmc-supply = <&reg_mmc3_vdd>;
+	vmmc-supply = <&reg_vcc3v3>;
+	mmc-pwrseq = <&mmc3_pwrseq>;
 	bus-width = <4>;
 	non-removable;
 	status = "okay";
+
+	brcmf: wifi@1 {
+		reg = <1>;
+		compatible = "brcm,bcm4329-fmac";
+		interrupt-parent = <&pio>;
+		interrupts = <7 10 IRQ_TYPE_LEVEL_LOW>; /* PH10 WL_HOST_WAKE */
+		interrupt-names = "host-wake";
+	};
 };
 
 &ohci0 {
 	status = "okay";
 };
 
 &ohci1 {
 	status = "okay";
 };
 
+&pio {
+	/* PI12 provides the 32 kHz LPO clock for the AP6210 WiFi/BT module. */
+	pinctrl-names = "default";
+	pinctrl-0 = <&clk_out_a_pin>;
+};
+
 &pwm {
 	pinctrl-names = "default";
 	pinctrl-0 = <&pwm0_pin>;
 	status = "okay";
 };
@@ -203,11 +217,22 @@
 };
 
 &uart2 {
 	pinctrl-names = "default";
 	pinctrl-0 = <&uart2_pi_pins>, <&uart2_cts_rts_pi_pins>;
+	uart-has-rtscts;
 	status = "okay";
+
+	bluetooth {
+		compatible = "brcm,bcm20702a1";
+		clocks = <&ccu CLK_OUT_A>;
+		clock-names = "lpo";
+		device-wakeup-gpios = <&pio 8 20 GPIO_ACTIVE_HIGH>; /* PI20 BT_WAKE */
+		host-wakeup-gpios = <&pio 8 21 GPIO_ACTIVE_HIGH>; /* PI21 BT_HOST_WAKE */
+		shutdown-gpios = <&pio 1 5 GPIO_ACTIVE_HIGH>; /* PB5 BT_REG_ON */
+		max-speed = <1500000>;
+	};
 };
 
 &uart3 {
 	pinctrl-names = "default";
 	pinctrl-0 = <&uart3_pg_pins>, <&uart3_cts_rts_pg_pins>;
-- 
